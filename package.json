    "parse5": "^8.0.1",
    "pg": "^8.23.1",
    "playwright": "^1.63.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
