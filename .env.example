# ---- required in production ----
NODE_ENV=production
APP_SECRET=change-me-to-64-random-characters        # same value on app + proxy service
DATABASE_URL=postgres://user:pass@host:5432/agm
APP_ORIGIN=https://agm-app.example.com              # public URL of the app
PROXY_ORIGIN=https://agm-proxy.example.com          # public URL of the proxy (MUST be a different origin)
SERVICE_MODE=all                                    # all | app | proxy
PORT=3000
PROXY_PORT=3001                                     # only used with SERVICE_MODE=all
PROXY_INTERNAL_ORIGIN=http://127.0.0.1:3001         # how the app's screenshot worker reaches the proxy
STORAGE_DIR=/data/storage                           # persistent volume for screenshots/attachments

# ---- email (magic links + notification digests) — pick one ----
EMAIL_FROM="AGM Feedback <feedback@your-domain.com>"
RESEND_API_KEY=
SMTP_URL=                                           # e.g. smtps://user:pass@smtp.example.com:465
DEV_LOGIN_LINKS=false                               # true = show login link on screen when no provider (evaluation only!)

# ---- optional providers ----
ANTHROPIC_API_KEY=                                  # enables LLM feedback validation (rules engine is always the fallback)
ANTHROPIC_MODEL=claude-opus-5-5
VALIDATION_TIMEOUT_MS=10000
OPENAI_API_KEY=                                     # server-side transcription (whisper-1), else browser speech recognition
DEEPGRAM_API_KEY=

# ---- tuning ----
NOTIFY_INTERVAL_MS=3600000                          # at most one digest per owner per hour
NOTIFY_SETTLE_MS=600000                             # wait for a burst of comments to finish
PROXY_TIMEOUT_MS=20000
SCREENSHOTS_ENABLED=true
